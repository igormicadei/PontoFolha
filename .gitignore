# Playwright MCP
.playwright-mcp/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage
*.lcov
.nyc_output

# Dependency directories
node_modules/
jspm_packages/
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional caches / history
.npm
.eslintcache
.stylelintcache
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.*
!.env.example

# parcel / next / nuxt build output
.cache
.parcel-cache
.next
out
.nuxt
.output

# Build output
dist
dist-ssr
*.local

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/

# Editor / OS
.vscode-test
.DS_Store

# pnpm / yarn v3
.pnpm-store
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
